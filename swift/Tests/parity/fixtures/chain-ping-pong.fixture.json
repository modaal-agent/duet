{
  "chain": "ping-pong",
  "description": "The seam receipt: ping's fired delegate crosses the Hop as pong's pingFired action; the emitting step is marked linkToNext in the fixture.",
  "dialect": 2,
  "initialStates": {
    "ping": {
      "sent": 0
    },
    "pong": {
      "received": 0
    }
  },
  "scenario": {
    "source": "DuetTestingTests/ChainScenarioTests.swift"
  },
  "steps": [
    {
      "action": {
        "case": "fire"
      },
      "expectedEffects": [
        {
          "kind": "run",
          "payload": {
            "case": "notifyListener",
            "value": {
              "count": 1
            }
          }
        }
      ],
      "label": "fire emits the fired delegate",
      "line": 155,
      "linkToNext": true,
      "node": "ping"
    },
    {
      "action": {
        "case": "pingFired",
        "value": {
          "count": 1
        }
      },
      "expectedEffects": [],
      "label": "the ping→pong seam",
      "line": 159,
      "node": "pong"
    },
    {
      "action": {
        "case": "fire"
      },
      "expectedEffects": [
        {
          "kind": "run",
          "payload": {
            "case": "notifyListener",
            "value": {
              "count": 2
            }
          }
        }
      ],
      "label": "a second fire on the same chain",
      "line": 163,
      "node": "ping"
    }
  ]
}
